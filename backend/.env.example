# App registered in Olist/Tiny
OLIST_CLIENT_ID=
OLIST_CLIENT_SECRET=
OLIST_REDIRECT_URI=http://localhost:8000/auth/callback

# Password sent by the app in the X-App-Password header
APP_PASSWORD=

# Upstash Redis (REST API) where the Olist tokens are stored. Required in production.
# When empty, tokens go to backend/tokens.json (local development only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Frontend URLs allowed by CORS (and as return address after the Olist login),
# separated by ";". E.g.: https://app.example.com;https://staging.example.com
CORS_ORIGINS=

# Optional. When empty, cookies are Secure whenever OLIST_REDIRECT_URI uses https://
# COOKIE_SECURE=
